NODE_ENV=production
CLOUDFLARE_WORKER=true
VYRO_IS_HTTPS=true
VYRO_DEBUG=false
VYRO_SESSION_SECRET=replace-with-at-least-32-random-characters
TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_DATABASE=vyro_db
TIDB_USERNAME=replace-with-your-tidb-username
TIDB_PASSWORD=replace-with-your-tidb-password
GEMINI_API_KEY=optional-gemini-key
