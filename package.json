{
  "name": "vyro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:chat\" \"vite\"",
    "chat": "tsx watch server.ts",
    "start": "tsx server.ts",
    "start:chat": "tsx server.ts",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cloudflare:dev": "npm run build && npx --yes wrangler@4 dev",
    "cloudflare:deploy": "npm run build && npx --yes wrangler@4 deploy"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tidbcloud/serverless": "^0.3.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.5",
    "concurrently": "^9.2.1",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vite": "^8.2.2"
  }
