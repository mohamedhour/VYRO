{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vyro-fashion",
  "main": "worker.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "limits": {
    "cpu_ms": 50
  },
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKER": "true",
    "VYRO_IS_HTTPS": "true",
    "VYRO_DEBUG": "false"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "SET_AFTER_CREATING_HYPERDRIVE"
    }
  ],
  "observability": {
    "enabled": true
  }
}
